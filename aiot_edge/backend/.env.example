# ━━━ 数据库配置（默认 SQLite，无需外部 MySQL）━━━
# sqlite = 使用本地 SQLite 文件（开箱即用，推荐本地开发）
# mysql  = 使用外部 MySQL 服务（生产环境）
DATABASE_TYPE=sqlite

# MySQL 配置（仅 DATABASE_TYPE=mysql 时生效）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=aiot_edge

# ━━━ JWT 认证 ━━━
JWT_SECRET_KEY=change_this_to_random_32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ━━━ 应用服务 ━━━
APP_HOST=0.0.0.0
APP_PORT=8000

# ━━━ 边缘计算阈值（触发告警判定）━━━
CPU_THRESHOLD=85.0
LATENCY_THRESHOLD=200.0
OFFLINE_TIMEOUT_SECONDS=30

# ━━━ DeepSeek AI 助手 ━━━
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ━━━ 邮件 SMTP（邮箱验证码，可选）━━━
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_FROM_NAME=高校安防AIoT边缘协同预警系统
